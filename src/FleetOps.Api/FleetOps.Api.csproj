<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <NoWarn>$(NoWarn);NU1903</NoWarn>

    <UserSecretsId>cfaffcd6-65b2-4d4d-9fcc-552182a0a300</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Infrastructure\Data\Migrations\**" />
    <Content Remove="Infrastructure\Data\Migrations\**" />
    <EmbeddedResource Remove="Infrastructure\Data\Migrations\**" />
    <None Remove="Infrastructure\Data\Migrations\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Application\DTOs\" />
    <Folder Include="Application\Validators\" />
    <Folder Include="Domain\Enums\" />
    <Folder Include="Application\Interfaces\" />
    <Folder Include="Controllers\" />
    <Folder Include="Application\Services\" />
    <Folder Include="Common\" />
    <Folder Include="Extensions\" />
    <Folder Include="Infrastructure\Repositories\" />
    <Folder Include="Middleware\" />
  </ItemGroup>

  <ItemGroup>
    <EditorConfigFiles Remove="C:\Users\drive\source\repos\FleetOps\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\drive\source\repos\FleetOps\.editorconfig" />
  </ItemGroup>

</Project>
